# Copy to .env and fill in. Never commit .env.

# Public hostname. Caddy gets an HTTPS certificate for it automatically.
# Use "localhost" to try the stack on your own machine.
DOMAIN=storage.example.com

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=storage.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://storage.example.com
SECURE_HSTS_SECONDS=0

# Database (docker compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me

# Storage
SEGMENT_SIZE=4194304
MAX_FILE_SIZE=1073741824

# Key derivation: PBKDF2-SHA256 iterations the browser must use
KDF_ITERATIONS=600000
KDF_MIN_ITERATIONS=600000

# Rate limits for sign-in, sign-up and recovery. The per-IP limit is generous
# because mobile carriers put many users behind one address; the per-username
# limit is what slows down passphrase guessing.
AUTH_THROTTLE_RATE=120/minute
AUTH_USER_THROTTLE_RATE=10/minute

# Web server
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
LOG_LEVEL=INFO
